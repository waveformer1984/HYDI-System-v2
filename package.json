{
  "name": "heidi-cascade-production",
  "version": "1.0.0",
  "description": "Heidi Production Agent - CASCADE Implementation",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "server": "node src/server.js",
    "prebuild": "echo 'Prebuild complete'",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/hydi-v3 tests/unit/hydi-v3 scripts/performance-benchmark.js scripts/security-audit.js scripts/soak-test.js scripts/production-readiness-score.js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration/hydi-v3-integration.test.js --testMatch=\"**/*.test.js\" --runInBand --forceExit",
    "test:soak": "node scripts/soak-test.js",
    "benchmark:performance": "node scripts/performance-benchmark.js",
    "security-audit": "node scripts/security-audit.js",
    "production-readiness-score": "node scripts/production-readiness-score.js",
    "validate:hydi": "node scripts/continuous-validation.js",
    "validate:release": "node scripts/continuous-validation.js --full --release"
  },
  "keywords": [
    "protoforge",
    "kilo",
    "cascade",
    "ursula"
  ],
  "author": "ProtoForge Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.106.2",
    "@types/node": "^20.19.41",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.5.2",
    "next": "^15.5.18",
    "ollama": "^0.6.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sqlite3": "^6.0.1",
    "stripe": "^22.1.1",
    "typescript": "^5.0.0",
    "uuid": "^14.0.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@types/jest": "^29.5.14",
    "autoprefixer": "^10.5.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.18",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "brace-expansion": ">=5.0.6",
    "glob": "^10.4.5",
    "qs": ">=6.15.2",
    "ws": "$ws",
    "postcss": "$postcss"
  }
}
