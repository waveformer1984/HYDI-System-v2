{
  "name": "heidi-cascade-production",
  "version": "1.0.0",
  "description": "Heidi Production Agent - CASCADE Implementation",
  "private": true,
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks || true",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "server": "node src/server.js",
    "prebuild": "echo 'Prebuild complete'",
    "build": "next build",
    "start": "next start",
    "lint": "eslint api pages components lib src apps/ursula-frontend/src tests/unit --ext .js,.jsx,.ts,.tsx",
    "lint:hydi-v3": "eslint src/hydi-v3 tests/unit/hydi-v3 scripts/performance-benchmark.js scripts/security-audit.js scripts/soak-test-v3.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "node tests/hdi-adversarial.test.js",
    "test:integration:hydi-v3": "jest tests/integration/hydi-v3-integration.test.js --testMatch=\"**/*.test.js\" --runInBand --forceExit",
    "typecheck": "tsc --noEmit",
    "typecheck:hydi-v3": "tsc --noEmit -p tsconfig.typecheck.json",
    "check:ports": "node scripts/check-ports.js",
    "wait:dependencies": "node scripts/wait-for-dependencies.js",
    "start:hydi": "node scripts/start-hydi.js",
    "soak-test": "node scripts/soak-test.js",
    "soak-test:1h": "node scripts/soak-test.js --duration 3600000",
    "test:soak:hydi-v3": "node scripts/soak-test-v3.js",
    "benchmark:performance": "node scripts/performance-benchmark.js",
    "security-audit": "node scripts/security-audit.js",
    "validate:rezonate-contract": "node scripts/validate-rezonate-capability-contract.js",
    "stress-test": "node heidi-core/phase-5-stress-test.js",
    "stress-test:2m": "cross-env TEST_DURATION=120000 TASKS_PER_HOUR=120 node heidi-core/phase-5-stress-test.js",
    "stress-test:10m": "cross-env TEST_DURATION=600000 TASKS_PER_HOUR=60 node heidi-core/phase-5-stress-test.js",
    "stress-test:1h": "cross-env TEST_DURATION=3600000 TASKS_PER_HOUR=60 node heidi-core/phase-5-stress-test.js",
    "boot": "node scripts/boot-agent.js",
    "boot:plan": "node scripts/boot-agent.js --dry-run",
    "boot:prod": "node scripts/boot-agent.js --prod",
    "preflight": "node scripts/preflight.js",
    "build:capacitor-www": "node scripts/build-capacitor-www.js"
  },
  "keywords": [
    "protoforge",
    "kilo",
    "cascade",
    "ursula"
  ],
  "author": "ProtoForge Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.108.2",
    "@types/node": "^20.19.41",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "next": "^15.5.19",
    "node-fetch": "^2.7.0",
    "nodemailer": "^9.0.3",
    "ollama": "^0.6.3",
    "pg": "^8.22.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "sqlite3": "^6.0.1",
    "stripe": "^22.3.2",
    "typescript": "^5.0.0",
    "uuid": "^11.1.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.20.0",
    "autoprefixer": "^10.5.4",
    "babel-jest": "^29.7.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.20",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "postcss": "^8.5.20",
    "supabase": "2.107.0",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "glob": "^10.4.5",
    "qs": ">=6.15.2",
    "ws": "$ws",
    "postcss": "$postcss",
    "test-exclude": {
      "glob": "^7.1.6"
    },
    "undici": "^6.27.0",
    "js-yaml": "^4.2.0",
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.7"
    },
    "sharp": "^0.35.0"
  }
}
