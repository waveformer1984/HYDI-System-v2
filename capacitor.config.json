{
  "appId": "com.protoforge.hydi",
  "appName": "HYDI Mobile Ops",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0a0a0f"
    }
  }
}
