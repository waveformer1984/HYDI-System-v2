# HEIDI Core Configuration
# Copy this to .env and fill in your values

# Server
HEIDI_PORT=3456
HEIDI_SECRET=your-secret-key-here-change-this-in-production

# Ollama (Brain)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Memory
HEIDI_DB_PATH=./data/heidi_memory.db

# Actions (optional)
HEIDI_APPROVED_DIRS=./scripts,./cleanup
