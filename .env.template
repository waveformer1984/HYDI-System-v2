# ProtoForge Environment Variables Template
# Copy this to .env.local and fill in actual values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_URL="https://your-project.supabase.co"

# Supabase Keys - Get from Supabase Dashboard
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Stripe Configuration - Get from Stripe Dashboard
STRIPE_SECRET_KEY="sk_live_your-live-key-here"
STRIPE_WEBHOOK_SECRET_01="whsec_your-webhook-secret-here"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret-here"
# Connect webhook secret — get from Stripe Dashboard > Webhooks > your Connect endpoint
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_your-connect-webhook-secret-here"

# Stripe Connect sub-account IDs — one per revenue stream
STRIPE_ACCOUNT_GALACTIC_BYTES="acct_your-galactic-bytes-id"
STRIPE_ACCOUNT_DETAILER_BOT="acct_your-detailer-bot-id"
STRIPE_ACCOUNT_LIPI_V2="acct_your-lipi-v2-id"
STRIPE_ACCOUNT_PROTOGRANCE_AROMATICS="acct_your-protogrance-id"
STRIPE_ACCOUNT_REZONATE="acct_your-rezonate-id"
STRIPE_ACCOUNT_WAVEFORMER_STUDIO="acct_your-waveformer-id"

# HYDI Service Auth — HMAC-SHA256 secret for inter-service token signing
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')" | clip
HYDI_SERVICE_SECRET="your-64-char-hex-secret-here"

# Webhook Configuration
webhook_endpoint="https://your-project.supabase.co/functions/v1/stripe-webhook"
NODE_ENV="production"

# HYDI Product Price IDs - Get from Stripe Dashboard
STRIPE_HYDI_STARTER_PRICE_ID="price_your-starter-price-id"
STRIPE_HYDI_PRO_PRICE_ID="price_your-pro-price-id"
STRIPE_HYDI_ENTERPRISE_PRICE_ID="price_your-enterprise-price-id"

# Security Notes:
# 1. Never commit .env files to version control
# 2. Use different keys for development and production
# 3. Rotate keys regularly (every 90 days recommended)
# 4. Monitor API key usage in Stripe dashboard
