{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/events/stream",
      "destination": "/api/events/stream"
    },
    {
      "source": "/chat",
      "destination": "/ursula-chat-portal.html"
    },
    {
      "source": "/portal",
      "destination": "/ursula-chat-portal.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
