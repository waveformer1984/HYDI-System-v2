{
  "version": "1.0.0",
  "description": "HYDI System Services Manifest",
  "metadata": {
    "environment": "production",
    "buildDate": "2026-06-26",
    "supervisor": "v1.0.0"
  },
  "services": {
    "memory-engine": {
      "name": "HYDI Memory Engine",
      "cmd": "node memory-engine.js",
      "cwd": "C:\\Users\\Owner\\HYDI-System-v2",
      "port": 9998,
      "required": true,
      "dependencies": [],
      "healthCheck": "http://localhost:9998/health",
      "timeout": 30000,
      "restart": "exponential",
      "env": {
        "NODE_ENV": "production"
      },
      "description": "Unified memory system: procedural workflows, knowledge base, semantic search"
    },
    "hydi-core": {
      "name": "HYDI Core — Autonomous OS",
      "cmd": "node hydi-core.js",
      "cwd": "C:\\Users\\Owner\\HYDI-System-v2",
      "port": 9997,
      "required": true,
      "dependencies": ["memory-engine"],
      "healthCheck": "http://localhost:9997/health",
      "timeout": 30000,
      "restart": "exponential",
      "env": {
        "NODE_ENV": "production"
      },
      "description": "Central orchestrator: coordinates agents, tasks, learning, and operations"
    },
    "docker-stack": {
      "name": "Docker Compose Stack (Ursula)",
      "cmd": "cd C:\\ProtoForge_Ecosystem\\Ursula_Suite && docker compose up",
      "cwd": "C:\\ProtoForge_Ecosystem\\Ursula_Suite",
      "port": 5000,
      "required": false,
      "dependencies": [],
      "healthCheck": "http://localhost:5000/health",
      "timeout": 60000,
      "restart": "exponential",
      "env": {},
      "description": "PostgreSQL, Redis, Flask API, ProtoHub — foundation of the stack (optional, will auto-retry)"
    },
    "heidi-bridge": {
      "name": "Heidi Bridge",
      "cmd": "python heidi-bridge.py",
      "cwd": "C:\\ProtoForge_Ecosystem",
      "port": 5050,
      "required": true,
      "dependencies": ["docker-stack"],
      "healthCheck": "http://localhost:5050/health",
      "timeout": 30000,
      "restart": "exponential",
      "env": {
        "BRIDGE_PORT": "5050",
        "URSULA_URL": "http://localhost:5000",
        "PROTOHUB_URL": "http://localhost:4000"
      },
      "description": "Bridges local data (protoforge.db, build_registry.json) to cloud systems"
    },
    "next-app": {
      "name": "Next.js Frontend + API",
      "cmd": "npm run dev",
      "cwd": "C:\\Users\\Owner\\HYDI-System-v2",
      "port": 3000,
      "required": true,
      "dependencies": ["docker-stack"],
      "healthCheck": "http://localhost:3000/api/health",
      "timeout": 45000,
      "restart": "exponential",
      "env": {
        "NODE_ENV": "development",
        "PORT": "3000",
        "HOSTNAME": "0.0.0.0"
      },
      "description": "Next.js development server with Supabase client and Stripe integration"
    },
    "heidi-mobile": {
      "name": "Heidi Mobile Chat UI",
      "cmd": "node launch-heidi-mobile.js",
      "cwd": "C:\\Users\\Owner\\HYDI-System-v2",
      "port": 3006,
      "required": false,
      "dependencies": [],
      "healthCheck": "http://localhost:3006/api/health",
      "timeout": 30000,
      "restart": "exponential",
      "env": {
        "HEIDI_PORT": "3006",
        "OLLAMA_URL": "http://localhost:11434",
        "LM_STUDIO_URL": "http://localhost:1234",
        "LOCAL_MODEL_NAME": "llama3"
      },
      "description": "Local mobile chat server, streams from Ollama/LM Studio"
    },
    "forge-loop": {
      "name": "ProtoForge Forge Loop",
      "cmd": "pwsh -NoExit -Command \".\\forge-loop.ps1 -IntervalMinutes 15\"",
      "cwd": "C:\\ProtoForge_Ecosystem",
      "port": null,
      "required": false,
      "dependencies": ["heidi-bridge"],
      "healthCheck": null,
      "timeout": 30000,
      "restart": "exponential",
      "env": {},
      "description": "Periodic build automation (PowerShell), runs on interval"
    }
  },
  "globalConfig": {
    "startupTimeout": 60000,
    "healthCheckInterval": 30000,
    "signalTimeout": 10000,
    "maxCrashes": 4,
    "crashWindow": 3600000
  },
  "notes": [
    "Services with 'required': true will fail startup if they don't come up",
    "Services are started in dependency order (topological sort)",
    "Health checks must return HTTP 200 OK within 5 seconds",
    "Crashed services auto-restart with exponential backoff (2s, 5s, 15s, 60s)",
    "On 4+ crashes in 1 hour, service is considered permanently broken",
    "Use supervisor.js --dry-run to see startup plan without launching",
    "Monitor via: http://localhost:9999/status"
  ]
}
