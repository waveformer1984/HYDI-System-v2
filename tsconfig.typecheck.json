{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/hydi-v3/**/*.js",
    "tests/unit/hydi-v3/**/*.js",
    "scripts/performance-benchmark.js",
    "scripts/security-audit.js",
    "scripts/soak-test-v3.js",
    "scripts/operator-cli.js",
    "scripts/hydi-cli.js",
    "scripts/hydi-operational-demo.js",
    "scripts/hydi-continuous-demo.js",
    "scripts/hydi-operator-demo.js",
    "scripts/console-benchmark.js",
    "pages/api/cockpit/**/*.js",
    "pages/api/console/**/*.js"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "coverage"
  ]
}
