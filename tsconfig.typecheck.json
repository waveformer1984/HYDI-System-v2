{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/hydi-v3/**/*.js",
    "tests/unit/hydi-v3/**/*.js",
    "scripts/performance-benchmark.js",
    "scripts/security-audit.js",
    "scripts/soak-test.js",
    "scripts/chaos-runner.js",
    "scripts/production-readiness-score.js",
    "scripts/observability-dashboard.js",
    "scripts/performance-trend.js"
  ],
  "exclude": ["node_modules", ".next", "coverage"]
}
