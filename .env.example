# ============================================================
# HYDI System — Environment Variables
# Heidi Mobile + ProtoForge Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Supabase (cloud memory + revenue ledger) ─────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# ── Stripe (checkout + Connect sub-accounts) ─────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET_01=whsec_...

# Stripe Connect sub-account IDs (one per revenue stream)
STRIPE_ACCOUNT_GALACTIC_BYTES=acct_...
STRIPE_ACCOUNT_DETAILER_BOT=acct_...
STRIPE_ACCOUNT_LIPI_V2=acct_...
STRIPE_ACCOUNT_PROTOGRANCE_AROMATICS=acct_...
STRIPE_ACCOUNT_REZONATE=acct_...
STRIPE_ACCOUNT_WAVEFORMER_STUDIO=acct_...

# ── AI Model Providers (Heidi's brain) ──────────────────────
# At least one is required for Heidi to generate responses.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...            # used for hosted memory embeddings (1536-dim)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # override to point SDK to compatible proxy

# Memory embeddings provider (optional)
# Auto-selected: 'openai' when OPENAI_API_KEY is set, else 'ollama' when local model enabled
# Set EMBEDDING_PROVIDER to force one. Ollama vectors are zero-padded to 1536 dims.
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Local LLM inference (optional)
# Local inference is skipped unless one of these is set.
# ENABLE_LOCAL_MODEL=true
# LOCAL_MODEL_URL=http://localhost:11434
# LOCAL_MODEL_NAME=llama3
# LOCAL_MODEL_TIMEOUT_MS=5000   # abort + routing gate; raise on slow CPU

# ── Email Integration (optional) ────────────────────────────
# Enables Heidi's send_email action
# RESEND_API_KEY=re_...
# EMAIL_FROM=heidi@yourdomain.com

# ── ProtoForge action enforcement (optional) ────────────────
# When unset, every action Heidi proposes from chat still gets a real
# KILO hypothesis + ProtoForge decision recorded to `decisions`, but
# nothing is ever blocked (observe-only). Set to 'true' to make decisions
# load-bearing: reject blocks the action, escalate parks it as a pending
# row the chat UI shows with Approve/Reject buttons (see
# lib/action-approval.ts, pages/api/actions/[id].ts). Requires a real
# active policy in the `policies` table — see
# supabase/migrations/20260714150000_promote_action_type_policy.sql.
# PROTOFORGE_ENFORCE_ACTIONS=true

# ── Heidi Services (local) ──────────────────────────────────
# heidi-core/server.js reads HEIDI_PORT for its OWN port. This is the exact
# variable name confusion that caused a real EADDRINUSE outage: an earlier
# version of this file labeled HEIDI_PORT "Mobile Chat API" and a prior
# HEIDI_CORE_PORT entry here was pure documentation -- the code never read
# it. Mobile chat now prefers the dedicated HEIDI_MOBILE_PORT below instead.
HEIDI_PORT=3459
# Mobile Chat API (launch-heidi-mobile.js) -- a DIFFERENT service from
# heidi-core above, dedicated var so the two can never collide on a port.
HEIDI_MOBILE_PORT=3006

# Optional: TLS cert/key for the mobile chat bridge above, so it's directly
# reachable over the tailnet as https:// (browsers block an https:// page,
# e.g. the GitHub Pages mobile client, from fetch()-ing a plain http:// API).
# Generate with `tailscale cert <machine>.<tailnet>.ts.net` on the host and
# point these at the resulting files. boot.config.json forwards both into
# the heidi-mobile-chat module automatically when set. Leave unset for
# LAN-only use -- launch-heidi-mobile.js falls back to plain HTTP.
# HEIDI_TLS_CERT=/path/to/machine.tailnet.ts.net.crt
# HEIDI_TLS_KEY=/path/to/machine.tailnet.ts.net.key

# ProtoForge Core (src/server.js) — a DIFFERENT service again from both of
# the above. Do not set this to 3006 or 3459.
PORT=3005

# Master switch for real (non-dry-run) autonomous action execution -- gates
# both /think's auto-action-detection and the mission worker
# (heidi-core/missions/mission-worker.js). Unset or anything other than the
# literal string "true" means dry-run only: actions are evaluated in full
# (permission-checked, isSafe()-checked) but never actually run.
# HEIDI_AUTONOMOUS_ACTIONS=true

# Shared secret required by /act and (for any non-localhost caller)
# /chat-tools. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HEIDI_SECRET=

# AI provider base URLs (local — leave defaults if running locally)
OLLAMA_URL=http://localhost:11434
LM_STUDIO_URL=http://localhost:1234

# ── ProtoForge Backend Services ─────────────────────────────
# Run heidi-bridge.py on Windows, then set to:
#   http://<your-windows-LAN-ip>:5050
URSULA_URL=http://192.168.86.82:5050

# Live Vercel Ursula (bridge proxies to this automatically)
# URSULA_VERCEL=https://ursula-nine.vercel.app

# Legacy services (leave as-is unless running locally)
PROTOHUB_URL=http://localhost:4000
HYDI_URL=http://localhost:3005

# ── Heidi Bridge (heidi-bridge.py on Windows) ────────────────
BRIDGE_PORT=5050

# Absolute path to C:\ProtoForge_Ecosystem on Windows
# Used by heidi-bridge.py to find protoforge.db + build_registry.json
PROTOFORGE_DIR=C:\ProtoForge_Ecosystem
DB_NAME=protoforge.db
REGISTRY_FILE=build_registry.json

# ── Next.js Application ─────────────────────────────────────
NODE_ENV=production
NEXT_APP_URL=http://localhost:3000

# ── Autonomous Agent Loop ────────────────────────────────────
# Set to true to enable background observe/reason/act cycle
AGENT_LOOP_ENABLED=false
# How often the cycle runs (minutes)
AGENT_LOOP_INTERVAL_MIN=15
# 'alert_only' (default) — can only send push alerts + queue pending actions
AGENT_AUTONOMY_LEVEL=alert_only
# Ollama model for reasoning (llama3.2 recommended, tinyllama as fallback)
AGENT_REASONING_MODEL=llama3.2
# How long to suppress repeat alerts of same type (minutes, default 240 = 4 hours)
AGENT_ALERT_COOLDOWN_MIN=240
# Push notification briefing hour (0-23, UTC)
BRIEFING_HOUR=8
