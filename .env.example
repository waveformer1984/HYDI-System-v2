# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET_01=whsec_...
webhook_endpoint=whsec_...

# Application Settings
NODE_ENV=production

# Service-to-Service Auth
# Shared HMAC-SHA256 secret for verifying requests from heidi-chat-portal.
# Must match HYDI_SERVICE_SECRET in the heidi-chat-portal deployment.
# Generate: node -e "require('crypto').randomBytes(32).toString('hex')"
HYDI_SERVICE_SECRET=your-64-char-hex-secret-here

# ── Phase 1: Self-Healing Engine ──────────────────────────────────────────────
# Claude API key — required for SelfHealingService to generate corrective strategies.
# Without this, healing calls return null and the loop continues unmodified.
ANTHROPIC_API_KEY=sk-ant-...

# HYDI Traces API — base URL for fetching recent trace/drift data.
# Defaults to http://localhost:3000/api/traces when unset.
HYDI_TRACES_URL=https://your-hydi-system.vercel.app/api/traces

# ── Phase 2: Redis Stream Broker ───────────────────────────────────────────────
# Upstash Redis REST credentials — required for cross-system event streaming.
# Create a database at https://console.upstash.com and copy the REST URL + token.
# Without these, all stream publish/consume calls are silent no-ops.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here
