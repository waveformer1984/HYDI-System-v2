# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET_01=whsec_...
webhook_endpoint=whsec_...

# Model Providers (Heidi's brain)
# At least one is required for Heidi to generate responses.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...            # used for hosted memory embeddings (1536-dim)
# EMBEDDING_MODEL=text-embedding-3-small
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # override to point the Anthropic SDK at a compatible proxy

# Memory embeddings provider (optional).
# Auto-selected: 'openai' when OPENAI_API_KEY is set, else 'ollama' when a local
# model is enabled. Set EMBEDDING_PROVIDER to force one. Ollama vectors are
# zero-padded to 1536 dims (cosine-preserving) to match the memories table.
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Local model (optional). Local inference is skipped unless one of these is set.
# ENABLE_LOCAL_MODEL=true
# LOCAL_MODEL_URL=http://localhost:11434
# LOCAL_MODEL_NAME=llama3
# LOCAL_MODEL_TIMEOUT_MS=5000   # local inference budget (abort + routing gate); raise on slow CPU

# Email (optional, enables Heidi's send_email action)
# RESEND_API_KEY=re_...
# EMAIL_FROM=heidi@yourdomain.com

# Application Settings
NODE_ENV=production
