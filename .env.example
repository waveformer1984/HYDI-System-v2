# Environment variables for HYDI-System-v2
# Copy to .env.local for local development

# Supabase
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=your-public-supabase-url

# Service authentication (shared secret between HYDI and callers)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HYDI_SERVICE_SECRET=your-64-char-hex-secret-here

# Vercel admin (set on HYDI Vercel project, not in local .env)
VERCEL_ADMIN_TOKEN=your-vercel-pat
VERCEL_TEAM_ID=your-team-id
VERCEL_PROJECT_HEIDI=prj_...
VERCEL_PROJECT_HYDI=prj_...
VERCEL_DEPLOY_HOOK_HEIDI=https://api.vercel.com/v1/integrations/deploy/...
VERCEL_DEPLOY_HOOK_HYDI=https://api.vercel.com/v1/integrations/deploy/...

# TermuxBridge (edge node tunnel URL — update when tunnel URL changes)
TERMUX_BRIDGE_URL=https://your-tunnel.trycloudflare.com
TERMUX_BRIDGE_SECRET=your-bridge-secret
