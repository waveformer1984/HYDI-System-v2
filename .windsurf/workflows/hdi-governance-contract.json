{
  "contract_version": "2.0.0",
  "frozen_at": "2026-04-24T21:30:00Z",
  "schema_hash": "a1b2c3d4",
  "policy_version": "1.0.0",
  
  "state_machine": {
    "phases": ["initialized", "audit", "execute", "verify", "completed", "reopen_audit", "failed"],
    "statuses": ["running", "paused", "completed", "failed"],
    "allowed_transitions": [
      {"from": "initialized", "to": "audit", "actor": "ursula"},
      {"from": "audit", "to": "execute", "actor": "auditor"},
      {"from": "audit", "to": "failed", "actor": "auditor"},
      {"from": "execute", "to": "verify", "actor": "executor"},
      {"from": "execute", "to": "reopen_audit", "actor": "executor"},
      {"from": "execute", "to": "failed", "actor": "executor"},
      {"from": "verify", "to": "completed", "actor": "verifier"},
      {"from": "verify", "to": "reopen_audit", "actor": "verifier"},
      {"from": "verify", "to": "failed", "actor": "verifier"},
      {"from": "reopen_audit", "to": "audit", "actor": "verifier"}
    ]
  },
  
  "agent_boundaries": {
    "auditor": {
      "can_read": ["hydi_runs", "hydi_findings"],
      "can_write": ["hydi_findings"],
      "can_transition": ["audit", "failed"]
    },
    "executor": {
      "can_read": ["hydi_runs", "hydi_findings", "hydi_tasks"],
      "can_write": ["hydi_tasks"],
      "can_transition": ["verify", "reopen_audit", "failed"]
    },
    "verifier": {
      "can_read": ["hydi_runs", "hydi_findings", "hydi_tasks", "hydi_verifications", "hydi_certifications"],
      "can_write": ["hydi_verifications", "hydi_certifications"],
      "can_transition": ["completed", "reopen_audit", "failed"]
    },
    "ursula": {
      "can_read": ["*"],
      "can_write": ["hydi_runs"],
      "can_transition": ["initialized", "audit"]
    }
  },
  
  "database_schema": {
    "tables": [
      {
        "name": "hydi_runs",
        "immutable_columns": ["run_id", "created_at", "context_version", "schema_hash", "policy_version"],
        "mutable_columns": ["current_phase", "status", "current_actor", "meta"],
        "constraints": ["valid_meta_keys"]
      },
      {
        "name": "hydi_events",
        "immutable_columns": ["event_id", "run_id", "seq", "timestamp", "type", "actor", "from_phase", "to_phase", "payload"],
        "mutable_columns": [],
        "constraints": ["unique_run_seq", "append_only"]
      },
      {
        "name": "hydi_findings",
        "immutable_columns": ["finding_id", "run_id", "created_at"],
        "mutable_columns": ["component", "severity", "description"],
        "rls_policy": "findings_heidi_only"
      },
      {
        "name": "hydi_tasks",
        "immutable_columns": ["task_id", "run_id", "created_at"],
        "mutable_columns": ["task_name", "status"],
        "rls_policy": "tasks_executor_only"
      },
      {
        "name": "hydi_verifications",
        "immutable_columns": ["verification_id", "run_id", "created_at"],
        "mutable_columns": ["component", "status", "baseline", "actual", "delta"],
        "rls_policy": "verifications_kilo_only"
      },
      {
        "name": "hydi_certifications",
        "immutable_columns": ["cert_id", "run_id", "issued_at"],
        "mutable_columns": ["certificate_status", "passed_count", "warning_count", "failed_count"],
        "rls_policy": "certs_kilo_only",
        "constraints": ["one_per_run"]
      }
    ]
  },
  
  "apis": {
    "hydi_transition": {
      "method": "POST",
      "path": "/functions/v1/hydi-transition",
      "required_params": ["run_id", "from", "to", "payload", "actor", "idempotency_key"],
      "atomic": true,
      "idempotent": true
    }
  },
  
  "slos": {
    "transition_latency_p95_ms": 500,
    "transition_latency_p99_ms": 1000,
    "replay_1k_events_ms": 5000,
    "failure_rate_max": 0.01
  },
  
  "change_process": {
    "requires_approval": [
      "state_machine_transitions",
      "agent_boundaries",
      "database_schema",
      "slos"
    ],
    "requires_tests": [
      "migration_transformer",
      "replay_fidelity",
      "performance_regression"
    ],
    "approval_marker": "STATE_MACHINE_APPROVED"
  },
  
  "signatures": {
    "schema_hash_sha256": "a1b2c3d4e5f6789012345678901234567890abcdef",
    "contract_hash_sha256": "will_be_populated_on_freeze"
  }
}
