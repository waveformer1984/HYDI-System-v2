#!/bin/sh
# Local pre-push gate -- runs the same checks GitHub Actions' typecheck and
# Jest Unit Tests steps run, so day-to-day development has a source of
# truth that doesn't depend on GitHub's CI being up. (Direct motivation:
# GitHub Actions sat stuck queued, repo-wide, for 24+ hours starting
# 2026-07-08 -- see project-hydi-actions-outage memory.)
#
# GitHub remains the remote and branch protection still requires its
# checks before merge -- this hook doesn't replace that, it just means a
# push never has to wait on or trust GitHub's uptime to know locally
# whether a change is good.
#
# Skip once (e.g. a deliberate WIP push) with: git push --no-verify
#
# Delete-only pushes (branch deletions) push zero code -- there is no diff
# to typecheck, lint, or test. Git passes lines on stdin in the format:
#   "<local-ref> <local-sha> <remote-ref> <remote-sha>"
# For a deletion, <local-ref> is "(delete)" and <local-sha> is all zeros
# (0000000...) -- we're not pushing any new content, just removing a remote
# ref. In that case we skip typecheck/lint/tests but still run the secret
# scan, which is cheap and harmless to keep.

# Read stdin: each line is "<local-ref> <local-sha> <remote-ref> <remote-sha>"
# A deletion has <local-sha> as all zeros (no new content being pushed).
IS_DELETE_ONLY=true
while read -r local_ref local_sha remote_ref remote_sha; do
  # If any ref being pushed has a non-zero local SHA, it's pushing content
  if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    IS_DELETE_ONLY=false
  fi
done

if [ "$IS_DELETE_ONLY" = "true" ]; then
  echo "[pre-push] Delete-only push detected -- skipping typecheck/lint/tests."
  echo "[pre-push] Scanning for live secrets..."
  node scripts/scan-live-secrets.js
  if [ $? -ne 0 ]; then
    echo "[pre-push] live secret detected -- push aborted (remove the secret before pushing)"
    exit 1
  fi
  echo "[pre-push] All checks passed (delete-only)."
  exit 0
fi

echo "[pre-push] Running typecheck..."
npm run typecheck
if [ $? -ne 0 ]; then
  echo "[pre-push] typecheck failed -- push aborted (use --no-verify to skip)"
  exit 1
fi

echo "[pre-push] Running lint..."
npm run lint
if [ $? -ne 0 ]; then
  echo "[pre-push] lint failed -- push aborted (use --no-verify to skip)"
  exit 1
fi

echo "[pre-push] Running test suite..."
npm test
if [ $? -ne 0 ]; then
  echo "[pre-push] tests failed -- push aborted (use --no-verify to skip)"
  exit 1
fi

echo "[pre-push] Scanning for live secrets..."
node scripts/scan-live-secrets.js
if [ $? -ne 0 ]; then
  echo "[pre-push] live secret detected -- push aborted (remove the secret before pushing)"
  exit 1
fi

echo "[pre-push] All checks passed."
exit 0
