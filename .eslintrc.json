{
  "root": true,
  "env": {
    "node": true,
    "jest": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "warn",
    "no-constant-condition": ["error", { "checkLoops": false }]
  },
  "ignorePatterns": ["node_modules", ".next", "coverage", "data", "dist", "archive"],
  "overrides": [
    {
      "files": [
        "pages/**/*.{js,jsx,ts,tsx}",
        "components/**/*.{js,jsx,ts,tsx}",
        "lib/**/*.{js,ts}",
        "hooks/**/*.{js,ts}"
      ],
      "extends": ["next/core-web-vitals"]
    },
    {
      "files": ["api/**/*.{js,ts}"],
      "parserOptions": { "sourceType": "module" }
    }
  ]
}
