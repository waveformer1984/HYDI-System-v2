# Build-time PUBLIC configuration for the Walkie app — copy to mobile/.env.
# Values here are compiled into the app binary, so NOTHING secret may go here
# (no LiveKit secret, no service-role key, no JWT secret).

# Backend base URL reachable from the phone (LAN IP in development).
EXPO_PUBLIC_WALKIE_API_URL=http://192.168.1.10:8787

# dev | supabase (must match the backend's AUTH_MODE)
EXPO_PUBLIC_WALKIE_AUTH_MODE=dev

# Supabase project URL + anon/publishable key (designed to be public).
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
