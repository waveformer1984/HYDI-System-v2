<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Foreground service that keeps a joined channel alive in the background.
       Declared types:
       - microphone: keeps while-in-use mic access so a background turn can transmit
       - mediaPlayback: lets a listen-only session (mic permission denied) run -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <service
      android:name="expo.modules.walkiebackground.WalkieForegroundService"
      android:exported="false"
      android:foregroundServiceType="microphone|mediaPlayback" />
  </application>
</manifest>
