{
  "name": "protoforge-walkie-server",
  "version": "0.1.0",
  "private": true,
  "description": "ProtoForge Walkie backend: auth, channel membership, short-lived LiveKit tokens and server-authoritative speaker arbitration",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "npm run build:web && node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:livekit": "WALKIE_TEST_LIVEKIT=1 node --import tsx --test --test-concurrency=1 test/livekit.integration.test.ts",
    "build:web": "node scripts/build-web.mjs",
    "typecheck:web": "tsc --noEmit -p web",
    "prestart": "npm run build:web",
    "owner-login": "tsx src/owner-login.ts",
    "test:e2e:web": "node e2e/qr-join.e2e.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "livekit-server-sdk": "^2.19.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@livekit/rtc-node": "^1.1.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "livekit-client": "^2.22.4",
    "playwright-core": "^1.56.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
