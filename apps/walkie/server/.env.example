# ProtoForge Walkie backend — copy to server/.env and fill in. NEVER commit .env.
# Every value below is a placeholder; none is a real credential.

NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# --- LiveKit -----------------------------------------------------------------
# What PHONES connect to. On a LAN dev setup use your computer's LAN IP, e.g.
# ws://192.168.1.10:7880. Production must be wss://.
LIVEKIT_URL=ws://192.168.1.10:7880
# What THIS SERVER calls (defaults to LIVEKIT_URL with http/https).
# LIVEKIT_API_URL=http://127.0.0.1:7880
# Must match the `keys:` entry in livekit/livekit.dev.yaml (or your LiveKit Cloud project).
LIVEKIT_API_KEY=walkie-dev-key
LIVEKIT_API_SECRET=walkie-dev-secret-change-me-0123456789abcdef

# --- Database ----------------------------------------------------------------
# Unset = in-memory (dev only, refused in production). The local HYDI Supabase
# Postgres works: walkie keeps its tables in its own `walkie` schema.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# --- Auth --------------------------------------------------------------------
# supabase: verify Supabase Auth access tokens (production).
# dev:      POST /v1/dev/session issues test tokens (refused when NODE_ENV=production).
AUTH_MODE=dev
WALKIE_DEV_AUTH_SECRET=replace-with-32+-random-characters-for-dev-only
# SUPABASE_URL=http://127.0.0.1:54321
# HS256 projects: the project's JWT secret. Omit to verify with the project's JWKS.
# SUPABASE_JWT_SECRET=
# Only needed to delete the Supabase auth user on account deletion. Server-side only.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Speaker arbitration -----------------------------------------------------
TALK_MAX_MS=30000                 # longest single turn
TALK_RENEW_TTL_MS=5000            # turn is reclaimed if not renewed within this
TALK_MIN_REQUEST_INTERVAL_MS=250  # min gap between talk requests per user+channel
TALK_BURST=6                      # max talk requests per window
TALK_BURST_WINDOW_MS=10000

JOIN_TOKEN_TTL_S=300
INVITE_TTL_HOURS=24
MAX_CHANNEL_MEMBERS=50

# --- iOS PushToTalk (Milestone 3) -------------------------------------------
# All four or none. With none, PTT tokens are stored but no pushes are sent.
# The .p8 key is a server-side SECRET (Apple Developer → Keys → APNs).
# APNS_KEY_FILE=/secure/path/AuthKey_XXXXXXXXXX.p8   # or APNS_KEY_P8 with \n-escaped contents
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_BUNDLE_ID=com.protoforge.walkie.dev          # pushes use topic <bundle id>.voip-ptt
