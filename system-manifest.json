  "external_integrations": {
    "stripe": {
      "type": "payment",
      "purpose": "Payment processing",
      "endpoints": ["payments", "webhooks", "checkout"],
      "auth_method": "api_key",
      "status": "active"
    },
    "supabase": {
      "type": "database",
      "purpose": "Data persistence",
      "tables": ["user_profiles", "decisions", "revenue_events", "system_performance"],
      "auth_method": "service_key",
      "status": "active"
    },
    "openai": {
      "type": "ai_model",
      "purpose": "External AI model access",
      "models": ["gpt-4", "gpt-3.5-turbo"],
      "auth_method": "api_key",
      "status": "configured"
    },
    "anthropic": {
      "type": "ai_model",
      "purpose": "External AI model access",
      "models": ["claude-3"],
      "auth_method": "api_key",
      "status": "configured"
    }
  },
  "data_flows": {
    "user_request": {
      "trigger": "api_request",
      "flow": ["server", "HYDISystem", "HeidiControlPlane", "HybridModelStack", "LocalModelAdapter"],
      "data_types": ["text", "context"],
      "storage": ["HeidiMemorySystem"]
    },
    "model_execution": {
      "trigger": "intelligence_request",
      "flow": ["HybridModelStack", "LocalModelAdapter", "local_models"],
      "data_types": ["prompt", "response"],
      "storage": ["HeidiMemorySystem"]
    },
    "payment_processing": {
      "trigger": "revenue_request",
      "flow": ["HeidiRevenueEngine", "stripe", "HeidiActionLayer"],
      "data_types": ["payment_data", "webhook_events"],
      "storage": ["supabase"]
    },
    "self_monitoring": {
      "trigger": "performance_tracking",
      "flow": ["HeidiSelfAwareness", "HeidiMemorySystem", "GlobalConstraintEnforcer"],
      "data_types": ["performance_metrics", "drift_scores"],
      "storage": ["local_files"]
    }
  },
  "scheduled_jobs": {
    "core_loop": {
      "schedule": "every_1_minute",
      "service": "HeidiCoreLoop",
      "purpose": "Continuous improvement cycle",
      "status": "active"
    },
    "reflection_cycle": {
      "schedule": "every_15_minutes",
      "service": "HeidiSelfAwareness",
      "purpose": "Self-reflection and drift detection",
      "status": "active"
    },
    "revenue_monitoring": {
      "schedule": "every_5_minutes",
      "service": "HeidiRevenueEngine",
      "purpose": "Revenue tracking and monitoring",
      "status": "active"
    },
    "system_audit": {
      "schedule": "daily",
      "service": "SystemAuditor",
      "purpose": "System audit and redundancy detection",
      "status": "pending_implementation"
    }
  },
  "webhooks": {
    "stripe_webhook": {
      "provider": "stripe",
      "endpoint": "/webhooks/stripe",
      "service": "HeidiRevenueEngine",
      "events": ["payment_intent.succeeded", "payment_intent.failed", "checkout.session.completed"],
      "status": "active"
    }
  },
  "api_endpoints": {
    "health": {
      "path": "/health",
      "method": "GET",
      "service": "server",
      "purpose": "System health check",
      "status": "active"
    },
    "process": {
      "path": "/api/process",
      "method": "POST",
      "service": "HYDISystem",
      "purpose": "Main request processing",
      "status": "active"
    },
    "status": {
      "path": "/api/status",
      "method": "GET",
      "service": "HYDISystem",
      "purpose": "System status and metrics",
      "status": "active"
    }
  },
