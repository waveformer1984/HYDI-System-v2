{
  "version": 1,
  "templates": {
    "scout": {
      "description": "Fetch public feeds and sources; no LLM.",
      "allowed_capabilities": ["pool.http_fetch", "health.check", "service.status"],
      "llm": false,
      "max_clones": 4,
      "per_task_timeout_ms": 120000,
      "per_day_task_budget": 200
    },
    "researcher": {
      "description": "Fetch URLs and summarize with local Ollama only.",
      "allowed_capabilities": ["pool.http_fetch", "pool.llm_complete"],
      "llm": true,
      "max_clones": 3,
      "per_task_timeout_ms": 180000,
      "per_day_task_budget": 80
    },
    "verifier": {
      "description": "Check evidence against acceptance criteria (local LLM).",
      "allowed_capabilities": ["pool.verify_evidence", "pool.llm_complete", "ops.task_verify"],
      "llm": true,
      "max_clones": 2,
      "per_task_timeout_ms": 120000,
      "per_day_task_budget": 100
    },
    "writer": {
      "description": "Draft proposals and docs; no execution.",
      "allowed_capabilities": ["pool.write_document", "pool.llm_complete"],
      "llm": true,
      "max_clones": 2,
      "per_task_timeout_ms": 180000,
      "per_day_task_budget": 40
    },
    "prompter": {
      "description": "Emit SPP-style operator text; never runs code.",
      "allowed_capabilities": ["pool.emit_spp"],
      "llm": false,
      "max_clones": 1,
      "per_task_timeout_ms": 60000,
      "per_day_task_budget": 30
    }
  },
  "forbidden_capability_prefixes": [
    "billing.",
    "evolution.execute",
    "evolution.rollback",
    "board.",
    "ops.task_approve",
    "ops.task_cancel",
    "ops.task_resume",
    "ops.recovery_execute"
  ],
  "forbidden_capability_permissions": ["fabric:control", "ops:build", "revenue:manage", "billing:tenants:manage"]
}